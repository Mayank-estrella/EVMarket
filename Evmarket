import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataset
def load_data(file_path):
    try:
        data = pd.read_csv(file_path)
        print("Data loaded successfully.")
        return data
    except Exception as e:
        print(f"Error loading data: {e}")

# Explore the dataset
def explore_data(data):
    print("First 5 rows of the dataset:")
    print(data.head())
    print("\nDataset Information:")
    print(data.info())
    print("\nStatistical Summary:")
    print(data.describe())

# Data Cleaning
def clean_data(data):
    print("\nCleaning data...")
    # Check for missing values
    missing_values = data.isnull().sum()
    print("Missing values in each column:")
    print(missing_values[missing_values > 0])
    
    # Fill or drop missing values as appropriate
    data.fillna(method='ffill', inplace=True)  # Forward fill for simplicity
    print("Missing values handled.")
    
    # Convert data types if necessary
    # Example: data['column_name'] = data['column_name'].astype('desired_type')
    
    return data

# Data Visualization
def visualize_data(data):
    plt.figure(figsize=(10, 6))
    sns.countplot(data=data, x='Make', order=data['Make'].value_counts().index)
    plt.title('Count of Electric Vehicles by Make')
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

    plt.figure(figsize=(10, 6))
    sns.histplot(data['Range'], bins=30, kde=True)
    plt.title('Distribution of Electric Vehicle Range')
    plt.xlabel('Range (miles)')
    plt.ylabel('Frequency')
    plt.tight_layout()
    plt.show()

# Save cleaned data
def save_cleaned_data(data, output_file):
    try:
        data.to_csv(output_file, index=False)
        print(f"Cleaned data saved to {output_file}.")
    except Exception as e:
        print(f"Error saving data: {e}")

# Main function to run the script
def main():
    file_path = 'path_to_your_downloaded_file.csv'  # Update this path
    output_file = 'cleaned_electric_vehicle_data.csv'
    
    data = load_data(file_path)
    explore_data(data)
    cleaned_data = clean_data(data)
    visualize_data(cleaned_data)
    save_cleaned_data(cleaned_data, output_file)

if __name__ == "__main__":
    main()
